# Cloudflare API token with Zone DNS Edit, scoped to one zone.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# Comma-separated FQDNs or labels. Strongly recommended.
# Example: lb.example.com,origin.example.com
CLOUDFLARE_RECORD_NAMES=

# Seconds. Minimum 60, default 300.
# CLOUDFLARE_POLL_RATE=300

# ipv4 | ipv6 | both
# CHANGE_FLARE_IP_MODE=ipv4

# Re-list Cloudflare records even when the public IP is unchanged.
# CHANGE_FLARE_ALWAYS_RECONCILE=false

# Enable process HTTP probes (Kubernetes). Example: 0.0.0.0:8080
# CHANGE_FLARE_HEALTH_BIND=

# RUST_LOG=info
